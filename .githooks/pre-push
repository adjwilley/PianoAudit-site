#!/bin/sh
# Pre-push: chain the Git LFS transfer. core.hooksPath bypasses .git/hooks, so
# without this a push in an LFS repo sends pointer files whose objects never
# reach the server (PianoAnalyzer was missing 172 MB of audio on 2026-08-19).
# No-op in repos without LFS objects. One-time setup per clone:
#   git config core.hooksPath .githooks
if command -v git-lfs >/dev/null 2>&1; then
  git lfs pre-push "$@" || exit 1
fi
exit 0
